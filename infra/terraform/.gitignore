# Terraform state
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/

# Local variable files, often contain secrets
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json